# Public configuration: values are embedded at build time. Rebuild after changes.
SITE_ORIGIN=https://exapolymer.ru
# Keep false on preview URLs. true requires the operator identity below.
SITE_INDEXABLE=false
# false: prepare a request locally; no form data is sent to Web3Forms.
# Enable only after validating the data-processing route and approving the policy.
FORM_DELIVERY_ENABLED=false
PRIVACY_OPERATOR=
PRIVACY_OPERATOR_ADDRESS=
